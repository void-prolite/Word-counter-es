---
// src/layouts/Layout.astro
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  robots?: string;
  canonical?: string;
  showSkeleton?: boolean;
}

const {
  title = "Contador de Palabras Online Gratis | Conteo de Palabras y Caracteres",
  description = "Contador de palabras online gratis y preciso. Cuenta palabras, caracteres con y sin espacios, frases, párrafos y tiempo de lectura en tiempo real con total privacidad.",
  robots = "index, follow",
  canonical = Astro.url.href,
  showSkeleton = false,
} = Astro.props;
---
<!doctype html>
<html lang="es" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  
  <!-- SEO Primary Meta Tags -->
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={robots} />
  <link rel="canonical" href={canonical} />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="https://contadordepalabras.online/favicon.png" />
  <meta property="og:locale" content="es_ES" />

  <!-- Twitter -->
  <meta property="twitter:card" content="summary" />
  <meta property="twitter:url" content={canonical} />
  <meta property="twitter:title" content={title} />
  <meta property="twitter:description" content={description} />
  <meta property="twitter:image" content="https://contadordepalabras.online/favicon.png" />

  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="shortcut icon" href="/favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Crimson+Pro:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Lora:ital,wght@0,400;0,500;0,600;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/style.css" />

  <!-- Fast Theme Execution to prevent FOUC -->
  <script is:inline>
    const storedTheme = localStorage.getItem('contador_palabras_tema');
    if (storedTheme) {
      document.documentElement.setAttribute('data-theme', storedTheme);
    }
  </script>
  
  <script src="/app.js" defer></script>
</head>
<body>
  {showSkeleton && (
    <div id="skeletonLoader" class="skeleton-screen" aria-hidden="true">
      <div class="skeleton-shell">
        <div class="skeleton-header">
          <div class="skeleton-box" style="width: 40px; height: 40px; border-radius: 8px;"></div>
          <div class="skeleton-box" style="width: 140px; height: 28px; border-radius: 6px;"></div>
        </div>
        <div class="skeleton-grid">
          <div class="skeleton-card"></div>
          <div class="skeleton-card"></div>
          <div class="skeleton-card"></div>
          <div class="skeleton-card"></div>
        </div>
        <div class="skeleton-editor"></div>
      </div>
    </div>
  )}

  <div class="app-shell">
    <Header />
    <main class="main-container">
      <slot />
    </main>
    <Footer />
  </div>

  <!-- Notification Toast -->
  <div id="toast" class="toast" role="status" aria-live="polite"></div>
</body>
</html>
